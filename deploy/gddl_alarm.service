[Unit]
Description=gddl_alarm device dashboard (Mongoose HTTP/HTTPS + PostgreSQL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 不指定 User/Group：以 systemctl 的调用者（通常是 root）身份运行
# 程序所有资源路径（data_config.json / web_root / certs）都是相对当前工作目录的
WorkingDirectory=/opt/gddl_alarm
ExecStart=/opt/gddl_alarm/gddl_alarm
Restart=always
RestartSec=3
# main.c 已注册 SIGTERM：收到后跳出 mg_mgr_poll 循环，释放连接与数据库再退出
KillSignal=SIGTERM
TimeoutStopSec=15
# 连接数上千时解除默认 fd 上限
LimitNOFILE=65535
# main.c 全部日志写 stderr，直接进 journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gddl_alarm
# 日志时间戳与告警时间窗统一按东八区
Environment=TZ=Asia/Shanghai
NoNewPrivileges=true
# ProtectSystem=full（systemd v215+，CentOS 7 也支持）：/usr、/boot、/etc 只读，
# 工作目录仍可写，用于 data_config.json / 可选 server.log。
# 不用 strict / ReadWritePaths（v231+，老 systemd 会报 "Failed to parse" / "Unknown lvalue"）。
ProtectSystem=full
# 不启用 ProtectHome：就地部署时程序目录可能位于 /root 或 /home 下，
# ProtectHome=true 会让该目录对服务不可见（启动即 FileNotFound）。
PrivateTmp=true

[Install]
WantedBy=multi-user.target
