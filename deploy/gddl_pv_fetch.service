[Unit]
Description=gddl_pv_fetch PV data fetcher (Python, writes PV detail tables)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 不指定 User/Group：以 systemctl 的调用者（通常是 root）身份运行
# pv_fetch_and_upsert.py 用相对路径读 data_config.json（pgConnStr），
# 水位线与日志写在脚本目录，因此工作目录必须是安装目录。
WorkingDirectory=/opt/gddl_alarm
ExecStart=/usr/bin/python3 /opt/gddl_alarm/pv_fetch_and_upsert.py
# 常驻采集（FETCH_INTERVAL_SECONDS 默认 30s）；异常退出后自动拉起
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gddl_pv_fetch
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
# ProtectSystem=full（systemd v215+，CentOS 7 也支持）：/usr、/boot、/etc 只读，
# 工作目录仍可写，用于 data_config.json / 水位线 / 日志。
# 不用 strict / ReadWritePaths（v231+，老 systemd 会报 "Failed to parse" / "Unknown lvalue"）。
ProtectSystem=full
# 不启用 ProtectHome：就地部署时脚本目录可能位于 /root 或 /home 下，
# ProtectHome=true 会让该目录对服务不可见（读取 data_config.json 即失败）。
PrivateTmp=true

[Install]
WantedBy=multi-user.target
